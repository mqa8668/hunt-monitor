DATABASE_URL=postgres://hunt:hunt@localhost:5432/hunt
TEST_DATABASE_URL=postgres://hunt:hunt@localhost:5432/hunt_test
LLM_PROVIDER=mock            # mock | openai
LLM_BASE_URL=                # any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_MODEL_CHEAP=
LLM_MODEL_STRONG=
LLM_DAILY_BUDGET_USD=0       # 0 = LLM pass disabled, rules only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
HUNT_USER_AGENT=             # empty = hunt-monitor/<version> (+https://github.com/mqa8668/hunt-monitor)
HUNT_ALLOW_LOCAL_FEEDS=false # true allows http://, localhost and file:// feed URLs (demo, tests)
HUNT_TIMEZONE=UTC
HUNT_LOCALE=en               # en | vi
LOG_LEVEL=info
METRICS_PORT=9464
HUNT_POLL_CRON=              # empty = every 5 minutes; the demo uses "* * * * *"
DEMO_MARKET_URL=http://localhost:8787
